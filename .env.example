# Database connection string (e.g. Neon, Supabase, AWS RDS PostgreSQL)
# For serverless deployment on Vercel, connection pooling URL is recommended
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT Secret for signing session tokens.
# Required in production: at least 24 random characters. Placeholder values are rejected.
JWT_SECRET="replace-with-a-long-random-production-secret"

# Optional comma-separated browser origins allowed to call the API with credentials.
# Native mobile clients do not need this. Leave empty for same-origin web only.
# CORS_ORIGINS="https://app.example.com"

# Public App Configuration
NEXT_PUBLIC_APP_NAME="suchii-group-operations-console"

# Gemini key for the Tender Desk chatbot.
# Create one at https://aistudio.google.com/apikey and replace the placeholder.
# The desk treats YOUR_GEMINI_API_KEY as "not configured" and never shows the real key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.8-flash"

# 2Captcha key for the Tenders module.
# Copy this line into .env and replace the placeholder with the key from your 2Captcha account.
# Leave the text below unchanged until then. The app treats it as "not configured" and never shows the real key.
TWOCAPTCHA_API_KEY="YOUR_2CAPTCHA_API_KEY"

# S3-compatible object storage (Neon DB Object Storage).
# When configured, BOQ files, received delivery photos, site progress photos,
# and employee profile images upload to Neon Object Storage instead of Google Cloud.
AWS_ENDPOINT_URL_S3="https://your-branch.storage.region.aws.neon.tech/"
AWS_ACCESS_KEY_ID="nak_live_your_access_key"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET="suchii-group"
